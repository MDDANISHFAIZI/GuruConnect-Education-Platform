HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM Provider: "mistral" | "openai" | "gemini" | "groq"
# Set LLM_MODEL to match your provider:
#   mistral  → mistral-small-latest | mistral-medium-latest | mistral-large-latest
#   openai   → gpt-4o-mini | gpt-4o | gpt-3.5-turbo
#   gemini   → gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash-exp
#   groq     → llama-3.3-70b-versatile | llama3-8b-8192
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest

# API Keys — set whichever provider you are using (others can be left blank)
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding model — uses SentenceTransformers (local, no API key required)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS Vector Store
FAISS_INDEX_DIR=./storage/faiss_index

# Retrieval Tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.35
